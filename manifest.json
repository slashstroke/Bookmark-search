{
  "manifest_version": 2,
  "name": "Bookmark Folder Search",
  "version": "0.3.0",
  "description": "Browse bookmark folders by keyboard. Address bar: 'b tools'. Popup: Ctrl+Shift+F.",
  "permissions": ["bookmarks"],
  "background": { "scripts": ["background.js"] },
  "omnibox": { "keyword": "b" },
  "browser_action": {
    "default_title": "Bookmark folder search",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": { "default": "Ctrl+Shift+F" },
      "description": "Open bookmark folder search"
    }
  },
  "browser_specific_settings": {
    "gecko": { "id": "bookmark-folder-search@example.local" }
  }
}
